+package com.example.petadoptioncommunity.web;
+import com.example.petadoptioncommunity.identity.IdentityPort;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.security.core.annotation.AuthenticationPrincipal;
+import org.springframework.web.bind.annotation.*;
+import java.util.*;
+@RestController @RequestMapping("/api/v1/me/notifications")
+public class NotificationsController {
+ private final JdbcTemplate db;private final IdentityPort identity;
+ public NotificationsController(JdbcTemplate db,IdentityPort identity){this.db=db;this.identity=identity;}
+ public record Notification(String id,String title,String content,String createdAt,String readAt){}
+ private final org.springframework.jdbc.core.RowMapper<Notification> mapper=(r,n)->new Notification(r.getString("id"),r.getString("title"),r.getString("content"),r.getTimestamp("created_at").toInstant().toString(),r.getTimestamp("read_at")==null?null:r.getTimestamp("read_at").toInstant().toString());
+ @GetMapping public Object list(@AuthenticationPrincipal IdentityPort.Actor actor,@RequestParam(required=false) String unread){
+  if(unread!=null&&!Set.of("true","false").contains(unread))throw new ApiFailure(400,"VALIDATION_ERROR","筛选参数无效");
+  return identity.withActiveActor(actor,List.of(),()->db.query("SELECT * FROM e4_notification WHERE user_id=?"+("true".equals(unread)?" AND read_at IS NULL":"")+" ORDER BY created_at DESC,id DESC",mapper,actor.userId()));
+ }
+ private Notification owned(IdentityPort.Actor actor,String id){var rows=db.query("SELECT * FROM e4_notification WHERE user_id=? AND id=?",mapper,actor.userId(),id);if(rows.isEmpty())throw new ApiFailure(404,"NOT_FOUND","通知不存在");return rows.get(0);}
+ @GetMapping("/{id}") public Object detail(@AuthenticationPrincipal IdentityPort.Actor actor,@PathVariable String id){return identity.withActiveActor(actor,List.of(),()->owned(actor,id));}
+ @PostMapping("/{id}/read") public Object read(@AuthenticationPrincipal IdentityPort.Actor actor,@PathVariable String id){return identity.withActiveActor(actor,List.of(),()->{owned(actor,id);db.update("UPDATE e4_notification SET read_at=COALESCE(read_at,UTC_TIMESTAMP(3)) WHERE user_id=? AND id=?",actor.userId(),id);return owned(actor,id);});}
+}
