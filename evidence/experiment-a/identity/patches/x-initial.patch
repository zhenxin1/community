+<template>
+  <section aria-label="管理员账号查询">
+    <h2>管理员 · 账号查询</h2>
+    <form @submit.prevent="search">
+      <label>账号包含<input v-model="accountContains"></label>
+      <label>状态<select v-model="status"><option value="">全部</option><option>ACTIVE</option><option>FROZEN</option></select></label>
+      <label>每页<select v-model.number="size"><option :value="10">10</option><option :value="20">20</option><option :value="50">50</option></select></label>
+      <button>查询</button><button type="button" @click="loadList">刷新 / 重试</button>
+    </form>
+    <p>时间均以 Asia/Shanghai 显示。刷新后分页可能随新增账号变化。</p>
+    <p v-if="loading" role="status">账号加载中…</p>
+    <p v-else-if="error" role="alert">查询失败：{{ error }}</p>
+    <template v-else-if="result">
+      <p>共 {{ result.total }} 个账号，第 {{ result.page }} 页</p>
+      <p v-if="!result.items.length">没有符合条件的账号。</p>
+      <ul v-else><li v-for="user in result.items" :key="user.id"><p>{{ user.account }} · {{ user.nickname }} · {{ user.role }} · {{ user.status }}</p><p>{{ user.id }} · {{ time(user.createdAt) }}</p><button @click="loadDetail(user.id)">核对详情</button></li></ul>
+      <button :disabled="filtersChanged || page <= 1" @click="page--; loadList()">上一页</button><button :disabled="filtersChanged || page * result.size >= result.total" @click="page++; loadList()">下一页</button>
+    </template>
+    <aside v-if="target">
+      <h3>账号详情</h3><p>目标：{{ target }}</p>
+      <p v-if="detailLoading">详情加载中…</p>
+      <p v-else-if="detailError" role="alert">详情读取失败：{{ detailError }} <button @click="loadDetail(target)">重试详情</button></p>
+      <template v-else-if="detail"><p>{{ detail.account }} · {{ detail.nickname }} · {{ detail.role }} · {{ detail.status }}</p><p>注册：{{ time(detail.createdAt) }}</p><p>简介：{{ detail.bio }}</p><p>最近处置原因：{{ detail.latestReason || '无' }}</p><p>最近处置时间：{{ time(detail.latestActionAt) }}</p><p>状态版本：{{ detail.stateVersion }}</p></template>
+      <button @click="closeDetail">关闭详情</button>
+    </aside>
+  </section>
+</template>
+<script>
+import { request } from '../api/client'
+import { session } from '../state/session'
+export default {
+  name: 'AdminUsers',
+  data: () => ({ session, accountContains: '', status: '', page: 1, size: 20, result: null, loading: false, error: '', target: '', detail: null, detailLoading: false, detailError: '', submitted: null, listGeneration: 0, detailGeneration: 0 }),
+  computed: { filtersChanged () { return !!this.submitted && (this.accountContains !== this.submitted.accountContains || this.status !== this.submitted.status || this.size !== this.submitted.size) } },
+  mounted () { this.loadList() },
+  beforeUnmount () { this.listGeneration++; this.detailGeneration++ },
+  methods: {
+    time (value) { return value ? new Intl.DateTimeFormat('zh-CN', { timeZone: 'Asia/Shanghai', dateStyle: 'medium', timeStyle: 'medium' }).format(new Date(value)) + '（Asia/Shanghai）' : '无' },
+    search () { this.page = 1; this.loadList() },
+    closeDetail () { this.detailGeneration++; this.target = ''; this.detail = null; this.detailLoading = false; this.detailError = '' },
+    validUser (value) {
+      return !!value && ['id', 'account', 'nickname'].every(key => typeof value[key] === 'string' && value[key].length > 0) && ['USER', 'ADMIN'].includes(value.role) && ['ACTIVE', 'FROZEN'].includes(value.status) && typeof value.createdAt === 'string' && Number.isFinite(Date.parse(value.createdAt))
+    },
+    validDetail (value, id) {
+      return this.validUser(value) && value.id === id && typeof value.bio === 'string' && Number.isSafeInteger(value.stateVersion) && value.stateVersion >= 0 && (value.latestReason === null || typeof value.latestReason === 'string') && (value.latestActionAt === null || (typeof value.latestActionAt === 'string' && Number.isFinite(Date.parse(value.latestActionAt))))
