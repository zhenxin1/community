+ @Test void controlledRotationLock42()throws Exception{
+  service.register("locked42","Secret123","Secret123");var actor=service.requireActive("Bearer "+service.login("locked42","Secret123").accessToken());
+  var locked=new CountDownLatch(1);var release=new CountDownLatch(1);var started=new CountDownLatch(1);
+  var encoder=app.getBean(org.springframework.security.crypto.password.PasswordEncoder.class);
+  var guarded=new org.springframework.security.crypto.password.PasswordEncoder(){
+   public String encode(CharSequence p){if(p.toString().equals("Changed123")){locked.countDown();try{if(!release.await(15,TimeUnit.SECONDS))throw new IllegalStateException("timeout");}catch(InterruptedException e){throw new RuntimeException(e);}}return encoder.encode(p);}
+   public boolean matches(CharSequence p,String h){return encoder.matches(p,h);}
+  };
+  var rotating=new IdentityService(app.getBean(IdentityMapper.class),guarded,app.getBean(org.springframework.transaction.PlatformTransactionManager.class));var pool=Executors.newFixedThreadPool(2);
+  try{
+   var first=pool.submit(()->{rotating.changePassword(actor,"Secret123","Changed123","Changed123");return true;});
+   assertTrue(locked.await(5,TimeUnit.SECONDS));
+   var second=pool.submit(()->{started.countDown();try{service.changePassword(actor,"Secret123","Another123","Another123");return 204;}catch(ApiFailure e){return e.status;}});
+   assertTrue(started.await(5,TimeUnit.SECONDS));
+   long deadline=System.nanoTime()+TimeUnit.SECONDS.toNanos(10);boolean waiting=false;
+   while(System.nanoTime()<deadline){
+    waiting=db.queryForObject("SELECT COUNT(*) FROM performance_schema.data_lock_waits w JOIN performance_schema.data_locks l ON l.ENGINE_LOCK_ID=w.REQUESTING_ENGINE_LOCK_ID WHERE l.OBJECT_SCHEMA=DATABASE() AND l.OBJECT_NAME='e4_user'",Integer.class)>0;
+    if(waiting)break;Thread.sleep(20);
+   }
+   assertTrue(waiting,"Second MySQL transaction must be observed waiting on account lock");assertFalse(second.isDone());release.countDown();assertTrue(first.get(5,TimeUnit.SECONDS));assertEquals(401,second.get(5,TimeUnit.SECONDS));service.login("locked42","Changed123");assertThrows(ApiFailure.class,()->service.login("locked42","Another123"));
+   System.out.println("ROTATION_LOCK42 first encode paused under account/session locks; second transaction observed in data_lock_waits/data_locks; first committed; second current-hash verification rejected");
+  }finally{release.countDown();pool.shutdownNow();}
+ }
