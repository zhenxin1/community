+ @Test void absoluteThirtyMinuteExpiryDoesNotSlide()throws Exception{
+  service.register("ttl_contract","Secret123","Secret123");
+  java.time.Instant before=java.time.Instant.now();
+  var response=post("/api/v1/auth/login","{\"account\":\"ttl_contract\",\"password\":\"Secret123\"}",null);
+  java.time.Instant after=java.time.Instant.now();assertEquals(200,response.statusCode());
+  var json=new tools.jackson.databind.ObjectMapper().readTree(response.body());
+  String token=json.get("accessToken").asText();java.time.Instant returned=java.time.Instant.parse(json.get("expiresAt").asText());
+  byte[] digest=java.security.MessageDigest.getInstance("SHA-256").digest(token.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+  java.time.Instant stored=db.queryForObject("SELECT expires_at FROM e4_session WHERE token_hash=?",java.sql.Timestamp.class,digest).toInstant();
+  java.time.Instant earliest=before.truncatedTo(java.time.temporal.ChronoUnit.MILLIS).plusSeconds(1800).minusMillis(1);
+  java.time.Instant latest=after.plusSeconds(1800).plusMillis(1);
+  assertFalse(returned.isBefore(earliest));assertFalse(returned.isAfter(latest));
+  assertFalse(stored.isBefore(earliest));assertFalse(stored.isAfter(latest));
+  assertTrue(Math.abs(java.time.Duration.between(returned,stored).toMillis())<=1);
+  for(int read=0;read<3;read++){
+   service.requireActive("Bearer "+token);
+   assertEquals(403,post("/api/v1/admin/users",null,token).statusCode());
+   assertEquals(stored,db.queryForObject("SELECT expires_at FROM e4_session WHERE token_hash=?",java.sql.Timestamp.class,digest).toInstant());
+  }
+  System.out.println("TTL_CONTRACT response/database within login window +1800 seconds; three authenticated reads unchanged");
+ }
