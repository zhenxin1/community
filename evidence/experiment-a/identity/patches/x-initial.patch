+        if (generation === this.listGeneration && token === session.accessToken) this.result = value
+      } catch (error) { if (generation === this.listGeneration && token === session.accessToken) this.error = error.message } finally { if (generation === this.listGeneration && token === session.accessToken) this.loading = false }
+    },
+    async loadDetail (id) {
+      const generation = ++this.detailGeneration; const token = session.accessToken
+      this.target = id; this.detail = null; this.detailError = ''; this.detailLoading = true
+      try {
+        const value = await request('/admin/users/' + encodeURIComponent(id), undefined, 'GET')
+        if (!this.validDetail(value, id)) throw new Error('账号详情响应无效，请重试')
+        if (generation === this.detailGeneration && token === session.accessToken) this.detail = value
+      } catch (error) { if (generation === this.detailGeneration && token === session.accessToken) this.detailError = error.message } finally { if (generation === this.detailGeneration && token === session.accessToken) this.detailLoading = false }
+    }
